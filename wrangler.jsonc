{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huable",
  "compatibility_date": "2026-04-20",
  "main": ".open-next/worker.js",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huable-db",
      "database_id": "958f0a31-1b9a-40bb-9fc6-52fecce06e64"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "huable_notes",
      "binding": "HUABLE_NOTES"
    }
  ]
}