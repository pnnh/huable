{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huable",
  "compatibility_date": "2026-04-20",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "huable.xyz",
      "zone_name": "huable.xyz",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CALIEO_OIDC_CLIENT_ID": "prism_8nStXRkJBZm_U9Se8RIs4Q",
    "CALIEO_OIDC_ISSUER": "https://portal.calieo.xyz",
    "CALIEO_OIDC_REDIRECT_BASE_URL": "https://huable.xyz"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huable-db",
      "database_id": "958f0a31-1b9a-40bb-9fc6-52fecce06e64"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "huable-notes",
      "binding": "HUABLE_NOTES"
    },
    {
      // Used by OpenNext incremental cache — must use this exact binding name
      "bucket_name": "huable-notes",
      "binding": "NEXT_INC_CACHE_R2_BUCKET"
    }
  ]
}